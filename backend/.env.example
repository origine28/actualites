# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=8080

# PostgreSQL
# Remplacez CHANGE_ME par le vrai mot de passe local (jamais commité).
DATABASE_URL=postgresql://news_app:CHANGE_ME@127.0.0.1:5432/news_db?schema=public

# Sécurité (utilisées à partir de la Phase 2 — exemples non sensibles)
# Doivent contenir au moins 32 caractères aléatoires.
# Générer avec : openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_au_moins_32_caracteres_aleatoires
CSRF_SECRET=CHANGE_ME_au_moins_32_caracteres_aleatoires

# Session & cookies (Phase 2)
# Durée de vie d'une session en heures (défaut : 24).
SESSION_TTL_HOURS=24
# "true" en production (HTTPS) pour émettre les cookies en Secure.
COOKIE_SECURE=false

# Anti brute-force (Phase 2)
# Verrouillage de compte après N échecs pendant M minutes.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Rate limiting IP sur /api/auth/login.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20

# Hachage des mots de passe (Phase 2) — Argon2id
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Stockage
# Tailles en octets : MAX_IMAGE_SIZE = 5 Mo, MAX_PDF_SIZE = 50 Mo, MAX_APP_SIZE = 100 Mo
STORAGE_ROOT=./storage
MAX_IMAGE_SIZE=5242880
MAX_PDF_SIZE=52428800
MAX_APP_SIZE=104857600

# CORS (Phase 8)
# Laisser vide pour same-origin (pas de headers CORS ajoutés).
# Exemple : CORS_ORIGIN=https://news.example.com
CORS_ORIGIN=
